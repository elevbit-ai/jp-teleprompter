<?xml version="1.0" encoding="utf-8"?>
<!-- JP Teleprompter - Joaquim Pedro de Morais Filho -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0B1020">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#4DFF88"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/subtitulo"
            android:textColor="#9AA6C0"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/lbl_roteiro"
            android:textColor="#E6ECFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edRoteiro"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="6dp"
            android:background="#16203A"
            android:gravity="top|start"
            android:hint="@string/hint_roteiro"
            android:inputType="textMultiLine|textCapSentences"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#67738F"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/lbl_tamanho"
            android:textColor="#E6ECFF"
            android:textSize="15sp" />

        <SeekBar
            android:id="@+id/sbTamanho"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="30" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/lbl_opacidade"
            android:textColor="#E6ECFF"
            android:textSize="15sp" />

        <SeekBar
            android:id="@+id/sbOpacidade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="70" />

        <Button
            android:id="@+id/btIniciar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="#1FBF66"
            android:text="@string/bt_iniciar"
            android:textColor="#04210F"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btWhats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="#25D366"
            android:text="@string/bt_whats"
            android:textColor="#04210F"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btParar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="#394867"
            android:text="@string/bt_parar"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/como_usar"
            android:textColor="#9AA6C0"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/creditos"
            android:textColor="#5C6885"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
