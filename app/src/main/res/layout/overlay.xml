<?xml version="1.0" encoding="utf-8"?>
<!-- JP Teleprompter - painel flutuante (overlay) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Barra de controle / arraste -->
    <LinearLayout
        android:id="@+id/barra"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#CC101828"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:paddingEnd="4dp"
            android:text="@string/overlay_mover"
            android:textColor="#4DFF88"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btMenos"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="44dp"
            android:text="A-" />

        <Button
            android:id="@+id/btMais"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="44dp"
            android:text="A+" />

        <Button
            android:id="@+id/btOpMenos"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="44dp"
            android:text="☾" />

        <Button
            android:id="@+id/btOpMais"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="44dp"
            android:text="☀" />

        <Button
            android:id="@+id/btTopo"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="44dp"
            android:text="⭱" />

        <Button
            android:id="@+id/btFechar"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="44dp"
            android:text="✕" />
    </LinearLayout>

    <!-- Area do roteiro: rola com o dedo -->
    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#B4000000"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/tvRoteiro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="18dp"
            android:paddingBottom="400dp"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:lineSpacingExtra="8dp"
            android:shadowColor="#000000"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="6" />
    </ScrollView>
</LinearLayout>
